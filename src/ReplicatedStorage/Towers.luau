			-- Пределы хода ствола по вертикали, градусы — то же, что pitchMin/pitchMax
			-- у gun Колбы. Диапазон узкий нарочно: это винтовка, а не зенитка, и ствол,
			-- задранный в небо или уткнутый в собственную станину, читается как сломанная
			-- анимация. Вверх чуть больше, чем вниз: по Лицехватам турель тоже стреляет.
			pitchMin = -6,
			pitchMax = 10,
		},
		damage = 15,
		hp = 50,
		-- По станине и поворотному кругу, а не по задранному стволу: лезть жуку
		-- пришлось бы на тумбу.
		climbHeight = 6,
		targeting = "strongest", -- самая сильная одиночная цель
		targets = "both",
		fireMode = "projectile",
		projectileSpeed = 250, -- studs/сек: мгновенный долёт
		projectileRadius = 0.7, -- не из ТЗ, взято от Колбы

		-- Форма снаряда: не шар, а игла вдоль курса — та самая стеклянная игла-капсула,
		-- что сидит в барабане и о которой говорит вики. ХИТБОКС от этого не меняется
		-- вовсе: попадание как считалось по projectileRadius, так и считается (см. Projectile).
		projectileShape = "needle",

		-- Пробитие: убив врага, игла не гаснет, а идёт дальше и бьёт следующего на своём пути,
		-- теряя эту долю урона за каждого УБИТОГО. Раненый, но выживший гасит иглу,
		-- как и раньше: прошивает она труп, а не живого жука.
		pierce = 0.1,
	},

	-- Газообразная машина (Испаритель). Не целится и не стреляет: держит над собой облако
	-- аэрозоля и тикает уроном сразу по всем, кто в нём. Облако висит на areaHeight выше
	-- турели, поэтому наземные проходят под ним невредимыми — целей у неё только воздух.
	Vaporizer = {
		name = "Испаритель",
		fireRate = 5, -- тиков в секунду (урон каждые 0.2 сек)
		range = 8, -- радиус облака
		cost = 15,
		footprint = 2.6, -- сторона корпуса (Box, см. TowerBuilder.buildVaporizerModel)
		damage = 2, -- за тик
		hp = 40,
		-- Низкий корпус — его перелезают. По смыслу самой турели это ничего не ломает:
		-- Она и так бьёт только по воздуху, а наземные её лишь обходили.
		climbHeight = 3,
		targets = "air",
		fireMode = "area",
		areaHeight = 6, -- studs над пивотом турели: там висит центр облака
		locked = true, -- задача #56: строить нельзя без промокода (см. TowerUnlocks/PromoCode)
	},

	-- СКРЫТ ИЗ СТРОЙКИ по решению автора (задача #53): запись, модель и режим стрельбы
	-- целы и работают, но в списке игрока (BUILD_ORDER в TowerInteraction) её нет, и построить
	-- её нельзя. Вернуть в игру = дописать "Drill" в BUILD_ORDER.
	--
	-- Турель-дрель (Бур). Плита с торчащим вверх сверлом, которая ставится прямо на дорогу
	-- лабиринта: клетку она занимает как любая постройка, и жуки в неё упираются — но пока
	-- грызут, сверло грызёт их в ответ. Радиус ровно с клетку постройки: дальше соседней
	-- клетки Бур не достаёт.
	Drill = {
		name = "Бур",
		fireRate = 4, -- тиков в секунду (урон каждые 0.25 сек)
		-- В ТЗ стояло 4 studs с пояснением «1 клетка, строго контактный бой», но в игре
		-- «вплотную» — это не 4 studs. Замерено живым прогоном (задача #53): жук, который
		-- грызёт постройку, стоит в 4.09 studs от её пивота (по диагонали — 5.66): след постройки
		-- раздут на полуширину жука (Grid.Clearance), и ближе он подойти не может физически.
		-- С четырьмя Бур не доставал вообще никого, поэтому число поднято до 6 — это та же
		-- самая «1 клетка вокруг» из ТЗ, только считанная по реальной геометрии арены. Следующий
		-- ряд жуков (через клетку) дальше 8 studs и под удар не попадает.
		range = 6, -- 1 клетка вокруг себя, строго контактный бой
		cost = 30,
		footprint = 3.6, -- сторона плиты (Grid.BuildSize - 0.4, см. TowerBuilder.buildDrillModel)
		damage = 4, -- за тик
		hp = 150,
		-- Плита вровень с полом: её перелезают все, включая Мини. Именно так Бур
		-- и задуман — «ставится прямо на дорогу»: теперь по нему идут, а сверло грызёт
		-- идущих в ответ.
		climbHeight = 1.4,
		-- Урон по самому Буру от грызни срезан вдвое. Читается атрибутом ChewResist
		-- (ставит TowerBuilder.placeTower): его знают и грызня в EnemySpawner, и цена
		-- клетки в Grid — иначе поиск пути считал бы Бур вдвое дешевле, чем он есть.
		chewResist = 0.5,
		targets = "ground",
		fireMode = "area",
	},

	-- Центробежный распылитель (Центрифуга). Импульс по кругу на 360°: бьёт слабо, зато
	-- сразу по всем и по любым целям — она про массовое наложение дебаффов залитым
	-- элементом, а не про урон.
	Centrifuge = {
		name = "Центрифуга",
		fireRate = 1.5, -- импульсов в секунду (выброс каждые ~0.66 сек)
		range = 10, -- радиус брызг вокруг турели
		cost = 25,
		footprint = 2.2, -- диаметр резервуара (Tank, см. TowerBuilder.buildCentrifugeModel)
		damage = 3, -- за импульс
		hp = 70,
		climbHeight = 3.4, -- резервуар невысокий, его берут те же, кто берёт Стену
		targets = "both",
		fireMode = "area",
		locked = true, -- задача #56: строить нельзя без промокода (см. TowerUnlocks/PromoCode)
	},
}

return Towers
