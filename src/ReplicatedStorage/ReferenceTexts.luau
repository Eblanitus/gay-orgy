-- Описания элементов и жуков в справочнике лаборатории — тексты для игрока.
--
-- Смысл взят из вики (alchemy_td_effects, alchemy_td_enemies), но это не копия: из вики убраны
-- заметки для разработки, цифры и жаргон («стан», «реген», «DPS»). Вики — для дизайна, этот файл —
-- для игрока; правится руками. Поменялась механика в вики — поправить и здесь.
--
-- Ключ — имя, как в поле name таблиц Elements / Enemies. Цифр здесь нет: характеристики
-- справочник берёт из таблиц (EntityInfo.ElementStats).
local ReferenceTexts = {}

ReferenceTexts.elements = {
	["Алмаз"] = "Полностью пробивает броню и наносит самый сильный удар снарядом в игре. Родственник Обсидиана — и так же не отталкивает врага.",
	["Антиматерия"] = "Не ранит и не накладывает эффектов. Что она делает на самом деле — загадка.",
	["Атмосфера"] = "Подбрасывает жука и швыряет его в случайную точку карты. Высота броска каждый раз разная.",
	["Болото"] = "Сильно замедляет и ранит. Заражает жука болотной заразой: при касании она переходит на соседей, те тоже замедляются и заражают следующих — цепочка не обрывается.",
	["Ветер"] = "Разгоняет скорострельность быстрее Давления и чаще притягивает врага к турели.",
	["Взрыв"] = "Попадание взрывается и ранит всех вокруг цели, слегка расталкивая их от центра.",
	["Вода"] = "Замедляет и делает жука мокрым: каждое попадание продлевает замедление. Мокрый жук проводит электричество.",
	["Воздух"] = "С каждым выстрелом подряд турель стреляет всё быстрее, до предела; если цели долго нет, разгон сбрасывается. На пределе бьёт сильнее Земли — но только пока стреляет без остановки. Первое попадание притягивает врага к турели. Притянутого жука Воздух больше не тянет, но это может сделать другой элемент — например, Давление.",
	["Вспышка"] = "Горение сильнее, чем у Энергии. Каждое попадание на миг ослепляет — жук замирает.",
	["Вулкан"] = "Плавит жука и бьёт сильнее обычного, отталкивая его.",
	["Гейзер"] = "Обжигает и замедляет тем сильнее, чем быстрее бежит цель. Быстрым жукам от него хуже всего.",
	["Гидросфера"] = "Каждое убийство замедляет всех жуков на карте. Следующие убийства продлевают мокрость у тех, кто уже мокрый.",
	["Глина"] = "Оглушение копится с каждым попаданием; замедления нет. Если оглушённого Глиной жука поджечь, он застывает керамической статуей: она не двигается, стоит как стена и её можно чинить. Разбитая статуя просто исчезает — жук из неё не выходит.",
	["Гора"] = "Как Землетрясение: чем быстрее цель, тем сильнее удар. На месте убитого вырастает каменная преграда — чем крепче был жук, тем она больше и прочнее. Стоит, пока её не сломают, перекрывает клетку и заставляет жуков искать обход. Её можно чинить.",
	["Грунт"] = "Сильный удар с отталкиванием. Ненадолго ставит на жука метку Грунта: если такого жука добьёт Растение, выросшее растение будет сильнее.",
	["Грязь"] = "Делает жука мокрым и бьёт сильно, но не отталкивает.",
	["Давление"] = "Разгоняет скорострельность быстрее Воздуха и может притянуть одного и того же жука несколько раз.",
	["Дерево"] = "Как Растение, но плодов больше. Лишнее лечение не пропадает — оно добавляет постройке прочности сверх полной, без предела.",
	["Дождь"] = "При убийстве бьёт по области: ранит и ошпаривает жуков рядом. Затем над этим местом поднимается туча и делает мокрыми жуков под ней.",
	["Дым"] = "Копит попадания и потом бьёт разом. Противоположность Огню: огонь жжёт понемногу и сразу, дым молчит — и бьёт одним ударом.",
	["Жар"] = "Горение сильнее, чем у Энергии, а удар снаряда слабее. Стреляет быстрее.",
	["Жизнь"] = "Турель с Жизнью не стреляет по жукам — она лечит постройки.",
	["Засуха"] = "Ранит и поджигает. На месте смерти жука остаётся выжженная зона: она жжёт всех, кто в неё зайдёт, и высушивает мокрых.",
	["Звезда"] = "На месте смерти появляется зона, в которой горение со временем усиливается — слабое вначале, разрушительное потом, без предела. Хорошо работает вместе с замедлением. Каждое убийство Звездой продлевает зону, расширяет её и делает краснее. Накопив достаточно, зона взрывается, и на её месте остаётся белый карлик — маленькая зона на пределе силы. Убийства продлевают ему жизнь, но не увеличивают. Если долго не стрелять, зона гаснет.",
	["Звук"] = "Мощно отталкивает всех жуков вокруг цели.",
	["Землетрясение"] = "Чем быстрее бежит жук, тем сильнее удар; медленный получает мало. На месте убитого остаётся зона: по жукам внутри неё любая турель бьёт по тому же правилу — чем быстрее цель, тем больнее.",
	["Земля"] = "Бьёт сильнее обычного и отталкивает жука при каждом попадании.",
	["Извержение"] = "Самый сильный урон в секунду без всяких условий. К тому же понемногу разгоняет скорострельность.",
	["Иней"] = "Замедляет ход, атаку и регенерацию. Замедление хода само не проходит.",
	["Камень"] = "Удар непредсказуем: то слабый, то обычный, то очень сильный. Чем сильнее удар, тем дальше отбрасывает.",
	["Кирпич"] = "Каждое попадание подряд сильнее предыдущего — сколько бы ни прошло между выстрелами. Противоположность Камню: порядок против случайности. Чем сильнее удар, тем дальше отбрасывает.",
	["Кислород"] = "Раздувает горение: огонь на жуке тикает чаще, каждый тик слабее, но в сумме жжёт сильнее. Сочетается с другими эффектами.",
	["Кислота"] = "Часто и понемногу разъедает жука и постепенно растворяет его броню — после этого сильнее бьют и остальные турели. Временно отключает регенерацию и смывает Ржавчину. Обсидиан пробивает броню только сам, а Кислота растворяет её для всех.",
	["Кислотный дождь"] = "При убийстве появляется кислотное облако и разъедает жуков вокруг. Взрыва, как у обычного Дождя, нет.",
	["Континент"] = "Сильный удар с отталкиванием. При убийстве бьёт по всем жукам рядом — чем крупнее был убитый, тем сильнее.",
	["Лава"] = "Плавит жука и бьёт сильно, но не отталкивает. Расплавленный жук проводит электричество.",
	["Литосфера"] = "Самый сильный удар и самое сильное отталкивание. При убийстве земля на месте смерти поднимается или проваливается. Если в яму набьётся много жуков, сверху падает плита и давит их. Возвышенность со временем опускается обратно.",
	["Лужа"] = "Замедляет сильнее Воды и делает жука мокрым.",
	["Лёд"] = "Сразу полностью замораживает жука на время — без накопления. Замедляет ход, но не атаку и не регенерацию. После разморозки жук продолжает бой и восстанавливается быстрее.",
	["Металл"] = "Немного пробивает броню и вызывает кровотечение: оно начинается с первого попадания, усиливается с каждым следующим и не проходит до смерти. Чем быстрее жук восстанавливается, тем сильнее кровотечение.",
	["Метель"] = "Ослепляет, замедляет атаку и регенерацию. На месте смерти жука остаётся зона слепоты.",
	["Молния"] = "Поджигает и на миг оглушает при каждом попадании. Бьёт цепочкой, но только по мокрым жукам — в отличие от Электричества, которое бьёт цепочкой всегда.",
	["Мыло"] = "Очищает жука: снимает с него все эффекты, и он навсегда переходит на вашу сторону. Турели по нему больше не стреляют, стены он не грызёт, а его броня защищает его от других жуков. Убить его всё ещё можно.",
	["Облако"] = "Как Пар, но замедляет чуть сильнее и не обжигает. Жук, по которому стреляло Облако, после смерти взрывается и ошпаривает соседей.",
	["Обсидиан"] = "Полностью пробивает броню. Не отталкивает.",
	["Огонь"] = "Поджигает жука. Горение копится с каждым попаданием, без предела.",
	["Океан"] = "Замедляет. При убийстве — водный взрыв: ранит жуков вокруг и делает их мокрыми.",
	["Остров"] = "Всё сразу: замедляет, сильно бьёт и поджигает.",
	["Пар"] = "Ошпаривает: замедляет и обжигает одновременно.",
	["Пепел"] = "Ставит на жука метку до его смерти: растительные элементы бьют по нему сильнее и сильнее лечат. Мокрость смывает метку.",
	["Песок"] = "Бьёт очень часто и понемногу. Каждое попадание засыпает жука: замедляет и ослепляет, всё сильнее и без предела.",
	["Плазма"] = "Снаряд сам не ранит — весь урон идёт через горение. Стреляет ещё чаще, чем Жар.",
	["Порох"] = "Метит жука. Если по помеченному попасть огнём, лавой или паром — он взрывается, а элемент Взрыв даёт взрыв ещё сильнее. После взрыва метка пропадает.",
	["Пруд"] = "Замедляет сильнее Лужи и делает жука мокрым.",
	["Пыль"] = "Поддержка: сама почти не ранит, но ставит на жука метку до его смерти. Пока метка стоит, все эффекты на нём держатся дольше и бьют сильнее.",
	["Растение"] = "Из трупа убитого жука вырастает растение. Оно даёт плод, который летит к самой повреждённой постройке и чинит её. Метка Грунта на убитом делает растение сильнее в бою, метка Пепла — и в бою, и в лечении.",
	["Ржавчина"] = "Ржавый жук получает больше урона от снарядов всех турелей — но не от эффектов (в отличие от Пыли). Держится до смерти. Кислота смывает ржавчину.",
	["Смог"] = "Копит попадания и взрывается. Вокруг взрыва остаётся большая зона слепоты.",
	["Снег"] = "Замедляет атаку и регенерацию. При убийстве взрывается и оставляет снежное облако.",
	["Сталь"] = "Как Металл, но гораздо сильнее: и пробитие брони, и кровотечение намного мощнее.",
	["Стекло"] = "Быстрые попадания, вызывающие кровотечение.",
	["Стена"] = "Как Кирпич: каждое попадание подряд сильнее предыдущего. Но урон растёт быстрее и до большего предела.",
	["Суша"] = "Бьёт сильнее Грунта и дальше отталкивает.",
	["Торнадо"] = "Затягивает жуков вихрем к турели. Разгон скорострельности нарастает всё быстрее.",
	["Туман"] = "Ослепляет: жук замедляется и сбивается с пути, бредёт в случайные стороны. Урон слабее, чем у других элементов. Слепота копится без предела, но проходит раньше следующего выстрела — жук всё равно понемногу продвигается.",
	["Уголь"] = "Усиливает горение. Жук, убитый огнём с Углём, оставляет зону пепла: жуки, прошедшие через неё, получают метку Пепла. Когда через зону пройдёт достаточно жуков, она исчезает.",
	["Ураган"] = "Быстро стреляет и сильно притягивает. На месте убийства остаётся зона, где жуков сбивает с пути: к выходу они идут, но с трудом. Это не слепота.",
	["Холод"] = "Временно замедляет ход, атаку и регенерацию. С него начинается ветка холода.",
	["Электричество"] = "Каждое попадание бьёт цепочкой по соседям цели — всегда, даже без мокрости. Мокрых и расплавленных в цепочке ещё и коротко оглушает.",
	["Энергия"] = "Горение сильнее, чем у Огня.",
	["Яд"] = "Навсегда отключает жуку регенерацию и понемногу травит сквозь броню. Если долго не попадать, отравление проходит — но регенерация уже не вернётся.",
}

ReferenceTexts.enemies = {
	["Архитектор улья"] = { text = "Покрывает пол и стены хитином. По хитину жуки бегают быстрее, а обычный ремонт на нём не работает. Меняет карту навсегда.", lesson = nil },
	["Гигант"] = { text = "Огромный, с очень большим запасом здоровья и крепкой бронёй, но медленный. Идёт прямо к лаборатории и не останавливается, пока его не уничтожат. Пока турели заняты им, за ним проходят мелкие жуки.", lesson = nil },
	["Заживалка"] = { text = "Средний по размеру и здоровью, но восстанавливается почти сразу после урона. Мелкими попаданиями его не убить — нужен тяжёлый снаряд или сочетание элементов, чтобы уничтожить разом.", lesson = nil },
	["Кислотник"] = { text = "Сам ничего не ломает — плюёт кислотой на стены. Размягчённую стену работяги ломают в разы быстрее. Один кислотник безвреден, вместе с работягами — опасен.", lesson = nil },
	["Координатор"] = { text = "Стены не трогает. Указывает солдатам, какую турель атаковать: без него каждый идёт на ближайшую, с ним — все на одну. Уничтожьте координатора, и солдаты растеряются.", lesson = nil },
	["Кукольник"] = { text = "Заворачивает раненых жуков в коконы. Через время из кокона выходит жук посильнее: из разведчика — работяга, из работяги — солдат. Не оставляйте раненых.", lesson = nil },
	["Лицехват"] = { text = "Летает и не атакует. Присасывается к турели — и та перестаёт стрелять. Снять его можно только огнём других турелей; как только он погибает, турель снова работает. Здоровья мало, скорость высокая, а присосавшись, он получает совсем мало урона.", lesson = nil },
	["Матка"] = { text = "Прилетает, откладывает личинку и улетает. Личинка лежит на месте, а через время из неё вылупляется целая стая мелких жуков. Уничтожьте личинку, пока не поздно.", lesson = nil },
	["Медик"] = { text = "Не атакует. Лечит других жуков, переносит личинок и раненых. Его стоит убить первым, но он держится за спинами работяг.", lesson = nil },
	["Мимик"] = { text = "Прикидывается мешком, обломком или даже турелью и стоит неподвижно — турели его не замечают. В какой-то момент раскрывается и нападает.", lesson = nil },
	["Мини-жук"] = { text = "Маленький и быстрый, погибает от одного попадания. Зато их очень много, и одна турель не успевает по всем. Ведёт себя как Стандарт: бродит и пугается. Стены грызть не умеет.", lesson = "одной турели не хватает — нужно прикрыть больше места." },
	["Моль"] = { text = "Летит к турелям со светящимися элементами. Ничего не ломает и не ранит — просто летает и мешает.", lesson = "враги бывают не только на полу, но и в воздухе." },
	["Носитель"] = { text = "Несёт внутри других жуков. Уничтожьте его — и они высыплются наружу. Если он доберётся до лаборатории, выпустит их прямо за вашей обороной.", lesson = nil },
	["Пеликан"] = { text = "Летает от трупа к трупу и поедает их. Наевшись, опускается на землю, оставляет жукам строительный материал и идёт в бой.", lesson = nil },
	["Подрывник"] = { text = "Несёт заряд взрывчатки. Подходит к стене и подрывает её вместе с собой. Попадание в заряд взрывает его раньше времени.", lesson = nil },
	["Работяга"] = { text = "Ломает стены и стол, таскает строительный материал. Получив урон, отходит в укрытие и ждёт, пока соберётся группа, — потом возвращается вместе со всеми и нападает на турели. Один не опаснее разведчика, группа — уже проблема.", lesson = nil },
	["Разносчик"] = { text = "Впитывает элементы, которыми в него стреляют, — и не один. Накопив, взрывается всем впитанным.", lesson = nil },
	["Спринтер"] = { text = "Маленький, очень быстрый и хрупкий. Мчится к лаборатории мимо всего. Не успеете сбить в пути — добежит.", lesson = nil },
	["Стандарт"] = { text = "Обычный разведчик. Бродит по полу, находит стол и грызёт его. Получив урон, пугается и отступает, но скоро возвращается. По одному не опасен, но их много, и они всё время возвращаются.", lesson = "турели работают, но одного выстрела мало." },
	["Строитель"] = { text = "Толстый жук: ест обломки стен и мебели и строит из них. Все его постройки горят и ломаются тяжёлыми снарядами.\n• Стена — прячет жуков от огня турелей.\n• Пандус — приставляется к вашей стене, по нему жуки перебираются через неё: мелкие быстро, крупные медленнее.\n• Кормушка — куча еды: жуки рядом восстанавливают здоровье, пока она не опустеет.\n• Ямка — углубление у построек: жуки в ней ниже линии огня, и взрывы задевают их намного слабее.", lesson = nil },
	["Таран"] = { text = "Тяжёлый. Долго целится, потом разгоняется по прямой и проламывает преграды. На разгоне не может повернуть, а после удара оглушён. Против него — смещённые стены и повороты.", lesson = nil },
	["Тень"] = { text = "Маленький жук, на которого турели реагируют с опозданием. Это не невидимость — просто пока турель наводится, он уже пробежал.", lesson = nil },
	["Хмурый брон"] = { text = "Слепой: не видит турели, не пугается и не отступает. Бронированный и медлительный. Ходит вдоль стен по кругу и ломает всё на пути — стены, трубы, даже стол, если тот стоит на дороге. Специально мебель не ищет. Идёт, пока его не уничтожат.", lesson = "охраняйте и края комнаты. Против брони нужны тяжёлые снаряды и особые элементы." },
