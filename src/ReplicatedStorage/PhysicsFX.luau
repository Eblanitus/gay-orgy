-- Числа физики и останков: толчки незакреплённого, отрыв конечностей, обугливание,
-- след кровотечения. Только таблица — логика в ServerScriptService.Impulse и Corpses.
--
-- Всё здесь — вид, а не геймплей: маршрут, скорость, HP и прицел от этих чисел не зависят.
return {
	-- ============ Толчки всего, что не прикреплено (Impulse) ============
	-- «Любая отдача в игре толкает то, что имеет физику» (решение автора). Толкается любая
	-- незакреплённая сборка: трупы, оторванные части и всё, что появится позже. Персонажи
	-- игроков — нет: ими управляет клиент, и толчок с сервера у него откатится.
	blast = {
		speed = 38, -- studs/сек в эпицентре взрыва радиуса referenceRadius
		referenceRadius = 10, -- взрыв шире — сильнее, уже — слабее (в пределах clamp ниже)
		powerMin = 0.5,
		powerMax = 2,
		reach = 1.5, -- во сколько раз дальше радиуса урона летит ударная волна
		lift = 0.7, -- доля подброса вверх в направлении толчка
		spin = 9, -- рад/сек случайной закрутки в эпицентре
	},
	push = {
		-- Отдача, притяжение и подброс по жуку (Effects.addPush): толкают и лежащее рядом с ним.
		radius = 6, -- studs вокруг жука
		speedPerStud = 4, -- studs/сек на каждый stud смещения жука
		speedMax = 30,
		lift = 0.35,
	},
	hit = {
		-- Попадание снаряда толкает то, во что попало (сам труп при добивании, оторванные части).
		speed = 14, -- studs/сек при ударе в 100% макс. HP
	},

	-- ============ Досадка трупа ============
	-- Туша, замершая не на брюхе (упала со стены и встала на нос, легла на бок), получает
	-- мягкий доворот на брюхо. Проверяется всё время жизни трупа (см. цикл досадки в Corpses).
	settle = {
		check = 0.4, -- сек между проверками
		upright = 0.7, -- «на брюхе»: верх туши смотрит вверх хотя бы на столько
		still = 1.5, -- studs/сек: медленнее — значит, замерла
		spin = 3.5, -- рад/сек доворота
		flipAfter = 3, -- проверок подряд не на брюхе, после которых толчок меняется на перекат
		flipTime = 0.35, -- сек плавного переката на брюхо
		flipLift = 0.3, -- подъём на перекате, доля наибольшего габарита: лапы не цепляют пол
	},

	-- ============ Отрыв конечностей при смерти ============
	-- Доля добивающего удара f = урон / макс. HP. Меньше minFraction — ничего не отрывается,
	-- дальше каждые perPiece — ещё одна часть, но не больше maxPieces.
	gore = {
		minFraction = 0.2,
		perPiece = 0.18,
		maxPieces = 6,
		-- Что отрывается охотнее: вес в случайном выборе. Голова — только при headFraction и выше.
		weights = {
			antenna = 4,
			mandible = 3,
			leg = 2,
		},
		headFraction = 0.9,
		headChance = 0.5,
		speed = 22, -- studs/сек разлёта при f = 1
		speedMin = 9,
		lift = 0.8,
		spin = 14, -- рад/сек
		splatSize = 0.9, -- диаметр пятна на месте отрыва, в масштабе жука 1 (×Scale/3)
		fieldLimit = 90, -- потолок оторванных частей на поле; старые растворяются
	},

	-- ============ Обугливание ============
	-- Вид останков «обугливает» (Effects.RemainsOf): горел в момент смерти или добит огнём.
	char = {
		color = Color3.fromRGB(28, 24, 21),
		fade = 0.85, -- насколько к цвету угля (у обычного трупа — 0.5 к серому)
		smokeTime = 3, -- сек дыма после смерти
		smokeRate = 14,
	},

	-- ============ Останки без тела (CorpseRemains) ============
	-- Вид решает добивающий удар (Effects.RemainsOf, по вики).
	remains = {
		crush = {
			-- Давит: лепёшка в форме жука и пара отлетевших кусков.
			squash = 0.12, -- во сколько раз сплющивается деталь по вертикали
			minThickness = 0.05, -- studs: тоньше — мерцает с полом
			spread = 1.15, -- раздавленное расползается вширь
			layer = 0.015, -- studs подъёма на stud исходной высоты: верхние детали ложатся поверх
			color = Color3.fromRGB(34, 30, 26),
			darken = 0.6,
			pieceFraction = 0.4, -- как удар в долю макс. HP: два куска (см. gore)
		},
		melt = {
			-- Плавит: раскалённая лужица, остывает в корку и тает.
			sinkTime = 0.9, -- сек: тело оплывает
			glowTime = 1.5, -- сек лужа светится
			coolTime = 2.5, -- сек остывает в корку
			crustTime = 8, -- сек корка лежит
			fadeTime = 2, -- сек тает
			size = 1.1, -- диаметр лужи к габариту жука
			steamRate = 10,
			glow = Color3.fromRGB(255, 118, 28),
			crust = Color3.fromRGB(46, 36, 30),
		},
		dissolve = {
			-- Растворяет: оседает в пене, остаётся тающее пятно.
			sinkTime = 1.4,
			foamTime = 1.8,
			foamRate = 60,
			spotTime = 6, -- сек тает пятно
			size = 1,
			acid = Color3.fromRGB(196, 222, 84),
			spot = Color3.fromRGB(140, 160, 64),
		},
		gib = {
			-- Рвёт: лапы отлетают целыми, остальное осколками тает в полёте.
			fraction = 1.2, -- сила отлёта лап, как удар в долю макс. HP
			fragmentSpeed = 16, -- studs/сек
			lift = 0.9,
			fragmentTime = 0.6, -- сек до исчезновения осколка
		},
		destroy = {
			-- Уничтожает (Звезда): сгорает в свет без следа.
			time = 0.45,
			rise = 1.2, -- studs подъёма (× масштаб жука)
			color = Color3.fromRGB(255, 238, 180),
			brightness = 8,
			range = 16, -- studs (× масштаб жука)
		},
	},

	-- ============ След кровотечения ============
	-- Только под Кровотечением (Металл, Стекло, Сталь: bleeds = true в Elements).
	bleed = {
		step = 2.2, -- studs пути между каплями (×Scale/3)
		size = 0.45, -- диаметр капли (×Scale/3)
	},
}
