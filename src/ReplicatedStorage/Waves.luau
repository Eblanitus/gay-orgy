-- Уровень 2 «Бункер»: только каста разведчиков (Normal, Mini, Armored, Sprinter; Моль — отдельно,
-- см. ниже), только Колбы и элементы до тира 1 (правила уровня — поле rules в Levels,
-- проверки — в Tutorial). Уровень учит летунам (Моль готовит к Лицехвату) и крафту тира 1.
--
-- Волна одна — поток (решение автора): игрок открывает дверь, жуки идут непрерывно ~8 минут
-- и давят, потом кончаются. Сложность не в ХП, а в том, чтобы по ходу держать поле и успевать
-- ставить Колбы (строить можно всё время, buildDuringWave в Levels). Между волнами отстроиться
-- «на миллион турелей» больше нельзя — пауз нет, есть только короткие затишья.
--
-- stream (крутит WaveRunner):
--   units    — ХП и броня видов Бункера, заданы автором поверх Enemies: Стандарт 80 и броня 2,
--              Хмурый брон 100 (броня своя, 5), Мини 30, Спринтер 45. Моль не тронута (10).
--   segments — фон по порядку: duration секунд, rate жуков в секунду, mix — веса видов
--              (вид каждого жука — случайный по весам). Затишья — участки с rate 0.05.
--   bursts   — всплески: на секунде at из двери разом валит units (вид = число).
--              Всплеск нарочно больше, чем успевают убить турели, — в этом давление.
--   hints    — строка в журнал на секунде at от открытия двери.
--
-- Цифры подогнаны офлайн-симулятором (стратегия: Колба при каждой возможности): на Земле
-- стол теряет 17–32%, на Огне — до 94% (на грани), с Лужей или Грунтом почти цел — крафт тира 1
-- окупается заметно. Всего ~370 жуков, поток 8 минут. Мягкий старт: первые 60 с ~10 жуков,
-- первый всплеск на 95-й секунде. Финал — 60 с плотного фона и два всплеска подряд.
--
-- Стол грызёт Обычный, Спринтер бьёт его с разбега (breachBite); у Мини chewDamage = 0,
-- Броня ходит по периметру и ломает постройки — поэтому в каждый всплеск подмешаны Обычные
-- или Спринтеры.
--
-- Моли в потоке нет: она прилетает сама по одной (поле moths в Levels, спавн — WaveRunner).
local Waves = {
	{ number = 1, groups = {},
	hint = "ПОДСКАЗКА: за дверью поток жуков, пауз не будет. Ставь Колбы прямо по ходу боя, строить можно всегда",
	stream = {
		units = {
			Normal   = { hp = 80, armor = 2 },
			Mini     = { hp = 30 },
			Armored  = { hp = 100 },
			Sprinter = { hp = 45 },
		},
		segments = {
			{ duration = 60,  rate = 0.17, mix = { Normal = 1, Mini = 1 } },                            -- мягкий старт
			{ duration = 60,  rate = 0.38, mix = { Normal = 2, Mini = 2, Armored = 1 } },
			{ duration = 15,  rate = 0.05, mix = { Normal = 1 } },                                      -- затишье
			{ duration = 65,  rate = 0.44, mix = { Normal = 2, Mini = 2, Armored = 1, Sprinter = 1 } },
			{ duration = 15,  rate = 0.05, mix = { Normal = 1 } },                                      -- затишье
			{ duration = 85,  rate = 0.55, mix = { Normal = 2, Mini = 3, Armored = 1, Sprinter = 1 } },
			{ duration = 12,  rate = 0.05, mix = { Normal = 1 } },                                      -- затишье
			{ duration = 108, rate = 0.66, mix = { Normal = 2, Mini = 3, Armored = 2, Sprinter = 1 } },
			{ duration = 60,  rate = 0.88, mix = { Normal = 3, Mini = 3, Armored = 2, Sprinter = 2 } }, -- финал
		},
		bursts = {
			{ at = 95,  units = { Mini = 7, Normal = 2 } },                    -- первая толпа
			{ at = 150, units = { Sprinter = 6 } },                            -- рывок
			{ at = 190, units = { Armored = 5, Normal = 4 } },                 -- стена брони
			{ at = 235, units = { Mini = 12, Normal = 2 } },
			{ at = 280, units = { Normal = 7, Sprinter = 4 } },
			{ at = 330, units = { Armored = 7, Mini = 7 } },
			{ at = 370, units = { Sprinter = 7, Normal = 6 } },
			{ at = 405, units = { Mini = 14, Armored = 4 } },
			{ at = 435, units = { Normal = 10, Sprinter = 5, Armored = 4 } },  -- финал
			{ at = 465, units = { Mini = 12, Normal = 6, Armored = 4 } },
		},
		hints = {
			{ at = 60, text = "ПОДСКАЗКА: скрести два базовых элемента на крафт-столе, выйдет элемент сильнее. Вода + Вода = Лужа: бьёт чаще и замедляет толпу" },
			{ at = 125, text = "ПОДСКАЗКА: Спринтер бежит к столу и бьёт его с разбега. А на свет турелей с элементом прилетает Моль: она отвлекает турели, Колба бьёт и по воздуху" },
			{ at = 200, text = "ПОДСКАЗКА: Земля + Земля = Грунт. Бьёт вдвое сильнее Земли, броня его почти не держит" },
		},
	} },
}

return Waves
