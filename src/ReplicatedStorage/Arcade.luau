-- Числа аркады: машина, жуки, давка, тряска камеры. Только таблица — логика в
-- ServerScriptService.ArcadeMode (жуки, давка), StarterPlayerScripts.ArcadeCar (езда) и ArcadeHud (тряска).
-- Цель режима — просто давить жуков: ни раундов, ни наград.
return {
	car = {
		maxSpeed = 78, -- studs/sec вперёд
		maxReverse = 36,
		accel = 105, -- studs/sec^2
		brakeDecel = 160, -- studs/sec^2: газ против хода тормозит резче разгона
		coastDecel = 25, -- studs/sec^2: накатом без газа
		turnRate = 3.2, -- рад/сек на полном ходу
		turnAtRest = 0.35, -- доля поворота на месте: трогающаяся машина не крутится волчком
		steerResponse = 10, -- 1/сек: как быстро разворот догоняет руль
		traction = 5.5, -- чем меньше, тем сильнее заносит в повороте
		maxWheelSteer = math.rad(25), -- поворот передних колёс при полном руле — для вида
		squashRadius = 5.5, -- если у шаблона машины нет атрибута SquashRadius
		-- Физика сборки (клиент, StarterPlayerScripts.ArcadeCar).
		chassisDensity = 25, -- плотность рамы, остальные детали невесомые: тяжелее — легче расшвыривает трупы
		suspensionTravel = 1, -- studs хода колеса вверх и вниз от посадки
		suspensionDamping = 0.45, -- доля критического демпфирования: меньше — дольше качается после удара
		flipResetAfter = 1.5, -- сек на боку или крыше до автопереворота
		-- Момент давки.
		squashCarry = 0.8, -- доля скорости машины, с которой улетают туша и куски
		squashKick = 14, -- studs/sec: с такой скоростью появившийся труп минимум отлетает от корпуса
	},
	bugs = {
		count = 50,
		scale = 3, -- втрое крупнее шаблона
		speed = 6, -- studs/sec
		turnMin = 1.5, -- сек между сменами направления
		turnMax = 3.5,
		respawnDelay = 1.5, -- сек до появления нового жука вместо раздавленного
		fieldMargin = 10, -- studs от ограждения
		reach = 0.6, -- доля полуразмера туловища, добавляемая к радиусу давки
	},
	-- LOD походки: рядом с машиной жук шагает каждый кадр, дальше — реже с накопленным dt.
	gait = {
		near = 90,
		mid = 180,
		midEvery = 3,
		farEvery = 6,
		maxDt = 0.25,
	},
	splat = {
		size = 2.2, -- на жука масштаба 3
		drops = 4,
	},
	-- Тряска камеры при давке (клиент). Каждый раздавленный жук добавляет «удар»;
	-- удары копятся до 1 и гаснут. Смещение растёт с квадратом удара: одиночный жук —
	-- лёгкий толчок, пачка подряд — ощутимая тряска.
	shake = {
		perSquash = 0.6,
		decay = 1.8, -- удара в секунду
		offset = 1.6, -- studs при полном ударе
		roll = math.rad(3), -- крен камеры при полном ударе
		frequency = 22, -- Гц дрожи
	},
	-- Счётчик «раздавлено» подпрыгивает на каждого жука.
	counterPop = {
		scale = 1.35,
		time = 0.18,
	},
}
