-- Числа аркады: машина, жуки, давка, очки, тряска камеры. Только таблица — логика в
-- ServerScriptService.ArcadeMode (жуки, давка, очки), StarterPlayerScripts.ArcadeCar (езда),
-- ArcadeHud (счёт, комбо, тряска) и ArcadeFX (всплывающие очки, звук, камера, золотой жук).
-- Смысл режима — просто давить жуков: ни раундов, ни цели, ни конца. Очки, комбо и рекорд —
-- только чтобы давить было приятнее, они ничего не открывают.
return {
	car = {
		maxSpeed = 78, -- studs/sec вперёд
		maxReverse = 36,
		accel = 105, -- studs/sec^2
		brakeDecel = 160, -- studs/sec^2: газ против хода тормозит резче разгона
		coastDecel = 25, -- studs/sec^2: накатом без газа
		turnRate = 3.2, -- рад/сек на полном ходу
		turnAtRest = 0.35, -- доля поворота на месте: трогающаяся машина не крутится волчком
		steerResponse = 10, -- 1/сек: как быстро разворот догоняет руль
		traction = 5.5, -- чем меньше, тем сильнее заносит в повороте
		maxWheelSteer = math.rad(25), -- поворот передних колёс при полном руле — для вида
		squashRadius = 5.5, -- если у шаблона машины нет атрибута SquashRadius
		-- Камера: на скорости поле зрения шире — разгон чувствуется, а не только читается.
		fovBase = 70,
		fovFast = 84, -- на полной скорости
		fovResponse = 4, -- 1/сек: как быстро поле зрения догоняет скорость
		fovKick = 3, -- градусов толчка на каждого раздавленного (гаснет вместе с тряской)
		-- Физика сборки (клиент, StarterPlayerScripts.ArcadeCar).
		chassisDensity = 25, -- плотность рамы, остальные детали невесомые: тяжелее — легче расшвыривает трупы
		suspensionTravel = 1, -- studs хода колеса вверх и вниз от посадки
		suspensionDamping = 0.45, -- доля критического демпфирования: меньше — дольше качается после удара
		flipResetAfter = 1.5, -- сек на боку или крыше до автопереворота
		-- Момент давки.
		squashCarry = 0.8, -- доля скорости машины, с которой улетают туша и куски
		squashKick = 14, -- studs/sec: с такой скоростью появившийся труп минимум отлетает от корпуса
	},
	bugs = {
		count = 60,
		speed = 6, -- studs/sec у вида с speed = 1
		turnMin = 1.5, -- сек между сменами направления стаи
		turnMax = 3.5,
		respawnDelay = 1.2, -- сек до появления нового жука вместо раздавленного
		fieldMargin = 10, -- studs от ограждения
		reach = 0.6, -- доля полуразмера туловища, добавляемая к радиусу давки
		-- Стаи: жуки ходят кучками, а не поодиночке — по кучке можно проехать и собрать комбо.
		herdSize = 6, -- жуков в стае
		herdSpread = 14, -- studs: дальше от середины стаи жук подтягивается к своим
		herdPull = 0.6, -- насколько сильно отставший доворачивает к стае (0..1)
		wander = math.rad(35), -- личный разброс курса внутри стаи
		-- Новый жук появляется не под колёсами и не на другом краю поля, а рядом со своей
		-- стаей или на этом кольце вокруг машины — поле вокруг игрока не пустеет.
		spawnMin = 45,
		spawnMax = 140,
		-- Бегство: машина близко и едет — жук бросается прочь, а не ждёт колёс.
		fleeRadius = 26, -- studs от машины
		fleeCarSpeed = 12, -- studs/sec: медленнее машина не пугает
		fleeSpeed = 2.2, -- множитель скорости в панике
		fleeTime = 1.2, -- сек паники после испуга
		fleeJitter = math.rad(50), -- разброс бегства: стая рассыпается веером
	},
	-- Виды на поле. type — ключ таблицы Enemies (оттуда шаблон и масштаб, как на арене);
	-- шаблона нет в месте — вид пропускается. weight — доля появления, speed — множитель
	-- скорости, points — очки за давку, size — множитель масштаба вида для поля аркады.
	species = {
		{ type = "Normal", weight = 40, speed = 1, points = 10 },
		{ type = "Worker", weight = 14, speed = 1.15, points = 10 },
		{ type = "Mini", weight = 12, speed = 1.4, points = 15, size = 1.4 }, -- от середины scaleRange: ≈ 1.7, мельче Стандарта (3.0)
		{ type = "Armored", weight = 10, speed = 0.8, points = 15 },
		{ type = "Sprinter", weight = 8, speed = 1.9, points = 25 },
		{ type = "Larva", weight = 8, speed = 0.6, points = 10 },
		{ type = "Ram", weight = 5, speed = 0.9, points = 25 },
		{ type = "Giant", weight = 3, speed = 0.6, points = 40 },
	},
	-- Золотой жук: изредка один на поле, быстрый и пугливый, стоит много очков. Не пойман —
	-- через lifetime сек исчезает. Цвет и блеск рисует клиент (ArcadeFX) по атрибуту Golden.
	golden = {
		type = "Normal",
		everyMin = 25, -- сек между золотыми
		everyMax = 45,
		lifetime = 22,
		speed = 1.7,
		fleeRadius = 40,
		points = 150,
	},
	-- Комбо: давка в пределах window сек от прошлой продолжает серию. Множитель очков —
	-- по ступеням: с серии from множитель mult.
	combo = {
		window = 2.2,
		tiers = {
			{ from = 1, mult = 1 },
			{ from = 3, mult = 2 },
			{ from = 6, mult = 3 },
			{ from = 10, mult = 4 },
			{ from = 16, mult = 5 },
		},
	},
	-- LOD походки: рядом с машиной жук шагает каждый кадр, дальше — реже с накопленным dt.
	gait = {
		near = 90,
		mid = 180,
		midEvery = 3,
		farEvery = 6,
		maxDt = 0.25,
	},
	splat = {
		size = 2.2, -- на жука масштаба 3
		drops = 4,
	},
	-- Звуки давки — копии звуков интерфейса (SoundService.UISounds): своих звуков у аркады
	-- в месте нет. name — имя Sound там, volume — множитель громкости, pitch — высота,
	-- pitchPerCombo — прибавка высоты за каждую ступень комбо.
	sounds = {
		squash = { name = "Crackle", volume = 1, pitch = 0.8, pitchPerCombo = 0.08, cut = 0.35 },
		comboUp = { name = "Gain", volume = 1, pitch = 1, pitchPerCombo = 0.1 },
		golden = { name = "Jackpot", volume = 1, pitch = 1 },
		record = { name = "Win", volume = 1, pitch = 1 },
	},
	-- Всплывающие очки над раздавленным: подъём и время жизни.
	popup = {
		rise = 7, -- studs
		time = 0.9,
	},
	-- Тряска камеры при давке (клиент). Каждый раздавленный жук добавляет «удар»;
	-- удары копятся до 1 и гаснут. Смещение растёт с квадратом удара: одиночный жук —
	-- лёгкий толчок, пачка подряд — ощутимая тряска.
	shake = {
		perSquash = 0.6,
		decay = 1.8, -- удара в секунду
		offset = 1.6, -- studs при полном ударе
		roll = math.rad(3), -- крен камеры при полном ударе
		frequency = 22, -- Гц дрожи
	},
	-- Счётчик «раздавлено» подпрыгивает на каждого жука.
	counterPop = {
		scale = 1.35,
		time = 0.18,
	},
}
