WikiTexts.elements = {
	["Алмаз"] = "полное пробитие брони + максимальный урон снаряда в игре (10 базовых элементов). Брат обсидиана, без отдачи в том числе.",
	["Антиматерия"] = "не наносит урона, не накладывает эффектов. Загадка для игрока.",
	["Атмосфера"] = "подброс: при атаке жук отправляется в случайную точку на карте. Высота подброса случайная.",
	["Болото"] = "сильное замедление + урон. Накладывает эффект «Болотный»: при контакте с другим жуком передаётся. На переданных жуков действует замедление + свойство передавать дальше (бесконечная цепочка, зомби вирус).",
	["Ветер"] = "разгон быстрее Давления + чаще притяжение.",
	["Взрыв"] = "радиус поражения при попадании. Круговая небольшая отдача по площади.",
	["Вода"] = "Замедление, проводит электричество, продлевается при каждом попадании.",
	["Воздух"] = "разгон темпа стрельбы + притягивание. Темп растёт с каждым выстрелом подряд до потолка и сбрасывается, если цели давно нет. На потолке обгоняет Землю по урону в секунду — но только пока стреляет без перерыва. Первое попадание притягивает врага к турели (притянутого врага нельзя больше стянуть этим же элементом, но можно, например, давлением).",
	["Вспышка"] = "Горение сильнее Энергии. При попадании — микро-ослепление 0.1 сек (враг замирает на долю).",
	["Вулкан"] = "Плавление + множитель урона. Имеет отдачу.",
	["Гейзер"] = "эффект Импульс: и замедление, и горение растут со скоростью цели. Чем быстрее цель — тем хуже ей будет от атаки гейзера.",
	["Гидросфера"] = "при убийстве врага — замедление всей карты. Повторное убийство врага мокрым врагам увеличивает время действия мокрости.",
	["Глина"] = "накопительный стан, без замедления. При поджигании застаненного глиной врага элементом огня — превращается в керамическую статую на карте. Статуя имеет керамическое HP, не движется, не срабатывает при смерти (просто стена). Лечится. При разрушении — жук не продолжает бой, статуя просто исчезает.",
	["Гора"] = "наследует логику Землетрясения (урон растёт со скоростью цели), но оставляет физическую преграду на месте смерти жука. Прочность и размер зависят от HP убитого. Живёт вечно пока не сломается, блокирует клетку, пути пересчитываются. Лечится.",
	["Грунт"] = "множитель урона + отдача. Доп: если Растение убивает врага с меткой Грунта, свойства Растения сильнее. Длительность эффекта — ограниченное время.",
	["Грязь"] = "Мокрый + урон. Без отталкивания.",
	["Давление"] = "разгон быстрее + больше притягивающих снарядов на жука.",
	["Дерево"] = "как Растение, но больше плодов. Перехил добавляет прочность постройке. Потолка доп-прочности нет.",
	["Дождь"] = "при убийстве появляется удар, который наносит урон по врагам по области, накладывает ошпаривание. После удара взлетает туча и даёт мокрость жукам под ней.",
	["Дым"] = "накопление до пробоя. Копит попадания, затем бьёт разом. Противоположность огню: огонь тикает слабо и сразу, дым молчит и бьёт одним ударом.",
	["Жар"] = "Горение сильнее энергии, урон при попадании — меньше. Выше скорость атаки.",
	["Жизнь"] = "турель лечит постройки. Не целится и не бьёт врагов. Турель с Жизнью меняет поведение и становится хилером.",
	["Засуха"] = "Урон + эффект горения. При смерти жука появляется зона на карте, которая наносит чистый огненный урон. Долина смерти. Эффект мокрости исчезает в ней.",
	["Звезда"] = "при смерти врага появляется зона, в которой урон горения растёт со временем. Слабо в начале, катастрофически потом. Синергия с замедлением. Потолка нет. Определённое время жизни зоны после последнего выстрела. Каждое убийство Звездой продлевает время жизни и размер зоны, и делает её более красной. При определённом пороге — происходит взрыв и появляется белый карлик. Маленькая зона — максимальная мощность. Убийство Звездой продлевает время жизни белого карлика, но не увеличивает ему зону.",
	["Звук"] = "сильная круговая отдача.",
	["Землетрясение"] = "урон снаряда растёт со скоростью цели: чем быстрее бежит враг, тем сильнее удар, медленный получает мало. При убийстве оставляет на месте смерти зону: внутри неё правило «быстрая цель = больше урона» распространяется на любую турель, попадающую по врагу, который находится в этой зоне.",
	["Земля"] = "множитель урона снаряда + отдача. Отдача отталкивает при каждом попадании.",
	["Извержение"] = "сильнейший чистый урон в секунду. Добавляется эффект разгона, небольшой.",
	["Иней"] = "перманентное замедление движения (без размораживания) + замедление атаки + замедление регена. Не стан.",
	["Камень"] = "рандомизатор урона: иногда мало, иногда стандарт, иногда много. Отдача зависит от того, насколько сильный камень попался.",
	["Кирпич"] = "урон растёт с каждым попаданием подряд. Нет таймера сброса, нет накопления по времени — каждое следующее попадание изменяет урон в независимости от интервала. Антоним камня: порядок против хаоса. Отдача зависит от силы кирпича.",
	["Кислород"] = "катализатор горения: ускорение тиков горения на цели. Тики чаще, каждый слабее, суммарный DPS выше. Уникальное усиление горения. Спокойно стакается с другими.",
	["Кислота"] = "частый мелкий урон по времени. Накопительно снижает броню цели. Смывает Ржавчину с цели. Отличие от Обсидиана: тот пробивает броню сам, эта растворяет её для остальных. Также убирает регенерацию у жука, временно.",
	["Кислотный дождь"] = "при убийстве — облако кислоты, Разъедающий по остальным врагам в зоне. Без взрыва, как в обычном дожде.",
	["Континент"] = "множитель урона + отдача. При убийстве — единоразовый удар по области, наносит урон всем врагам рядом. Чем больше жук — тем сильнее удар.",
	["Лава"] = "Плавление + урон. Без отталкивания.",
	["Литосфера"] = "множитель урона максимальный + максимальная отдача. При убийстве — ландшафт карты поднимается/опускается. Без HP, изменяет рельеф. При определённом количестве врагов в изменённом ландшафте — если была яма, то появляется плита сверху и давит всех жуков, нанося урон. Если была возвышенность — медленно опускается до нормального уровня.",
	["Лужа"] = "замедление сильнее.",
	["Лёд"] = "даёт полный стан, на время. Мгновенный, без условий и накоплений. Жук продолжает бой после разморозки. Без замедления скорости атаки и регена. Но с замедлением скорости. Увеличивает регенерацию жука после разморозки.",
	["Металл"] = "небольшое пробитие брони, даёт эффект кровотечения. Урон начинается с первого попадания, каждое следующее усиливает эффект, не спадает до смерти цели. Дополнительно: урон кровотечения усиливается также от скорости регена цели (быстрый реген = сильнее эффект).",
	["Метель"] = "слепота + замедление скорости атаки от холода + замедление регена. При смерти жука появляется зона слепоты.",
	["Молния"] = "Горение + стан 0.3 сек при каждом попадании. Цепочка только по мокрым целям. Отличие от электричества: то бьёт по цепочке всегда, Молния — только по мокрым.",
	["Мыло"] = "феромон: накладывает Очищение навсегда.",
	["Облако"] = "как Пар, но замедляет чуть сильнее, и не ошпаривает. При убийстве врага — малый взрыв, который наносит урон окружающим и ошпаривает их эффектом пара. Облако атаковало врага -> враг получил эффект облачности -> враг после смерти нанес урон врагам эффектом пара.",
	["Обсидиан"] = "полное пробивание брони. Без отдачи.",
	["Огонь"] = "Горение, стакается. Бесконечно при каждом попадании.",
	["Океан"] = "замедление. При убийстве врага — водный взрыв: наносит урон и даёт Мокрость окружающим.",
	["Остров"] = "комбо всех элементов: замедление + DPS + горение.",
	["Пар"] = "Ошпаривание (замедление и горение вместе).",
	["Пепел"] = "метка на враге: увеличивает урон от растительных элементов и хилящие свойства. Длительность — до смерти жука. Смывается Мокростью.",
	["Песок"] = "очень частые слабые попадания, каждое накладывает эффект Зыбучий: замедление плюс слепота, усиливается с каждым попаданием. Потолка нет.",
	["Плазма"] = "урона от снаряда нет вообще, весь урон через эффект. Стреляет чаще Жара.",
	["Порох"] = "метка на цели, перманентно. Попадание с эффектом Горение, Плавление или Ошпаривание по помеченной цели — взрыв. Элемент Взрыва по помеченному — усиленный взрыв. После взрыва, эффект спадает.",
	["Пруд"] = "замедление сильнее Лужи.",
	["Пыль"] = "усилитель. Метка до смерти цели, накладывается однократно. Пока метка стоит, все эффекты на цели держатся дольше и бьют сильнее. Сам почти не наносит урона, является поддержкой. Усиливает всё, что можно усилить: урон, отдачу, притяжение, ремонт, феромон, распад. Не усиливает физические силы напрямую — усиливает эффекты, которые они накладывают.",
	["Растение"] = "при убийстве врага из трупа появляется растение. Растение даёт плод, который летит к ближайшей постройке и лечит её. Приоритет — чем ниже HP, тем выше. Метка Грунта на убитом враге усиливает боевые свойства растения. Метка пепла — увеличивает и боевые свойства, и лечебные.",
	["Ржавчина"] = "дебафф на враге: все туррели, стреляющие по ржавому, наносят больше урона. Лишь урон при попадании. Урон от эффектов не учитывается (противоположность пыли). Длительность — до смерти жука. Смывается Кислотой.",
	["Смог"] = "несколько попаданий накапливают эффект, затем — взрыв. Вокруг взрыва большая зона слепоты.",
	["Снег"] = "замедление атаки + замедление регена. При убийстве происходит взрыв, и потом появляется облако снега.",
	["Сталь"] = "как Металл, но сильнее (значительно сильнее пробитие и кровотечение).",
	["Стекло"] = "быстрые атаки, которые наносят эффект кровотечения.",
	["Стена"] = "наращивание урона сильнее Кирпича и имеет выше потолок накопления урона. Механика как у Кирпича: каждое попадание изменяет урон, без таймера сброса.",
	["Суша"] = "множитель урона выше Грунта + больше отдача.",
	["Торнадо"] = "притяжение к стреляющей турели, в вихревой форме. Скорость атаки разгоняется нелинейно.",
	["Туман"] = "слепота. Урон у элемента хуже остальных. При попадании враг замедлен и теряет направление: ходит в случайные стороны. Не стан. Стакается без потолка — блуждание короче интервала между выстрелами, окно для движения остаётся всегда.",
	["Уголь"] = "усиление эффекта горения. При убийстве врага (огнём, с эффектом Угля) на карте появляется зона пепла. Жуки, наступившие на зону, получают эффект Пепла. Количество жуков, которые могут получить эффект пепла — ограничено. После определённого промежутка прошедших по ней жуков — зона исчезает.",
	["Ураган"] = "темп и сильное притягивание. При убийстве врага — появляется зона дезориентации. Жуки всё ещё идут к выходу, но тяжелее. Отличается от слепоты.",
	["Холод"] = "замедление движения + замедление атаки + замедление регена — все временное. База для последующей ветки холода.",
	["Электричество"] = "цепочка: при попадании бьёт врагов, стоящих рядом с целью, всегда (даже без Мокрого). Собственный эффект Электронность — короткий стан, накладывается только на проводящих целей в цепочке (на тех, на ком висит Мокрый или Плавление).",
	["Энергия"] = "Горение сильнее.",
	["Яд"] = "анти-реген (полная блокировка, до смерти жука) + слабый урон по времени. Игнор брони для эффекта Яда. Спадает через определённое время без попаданий. Сам яд спадает, но реген к жуку не возвращается.",
}

WikiTexts.enemies = {
	["Архитектор улья"] = { text = "Заменяет пол и стены хитином. На хитине жуки быстрее. Обычный ремонт невозможен. Меняет карту навсегда.", lesson = nil },
	["Гигант"] = { text = "Огромный размер. Очень много здоровья. Высокая броня. Низкая скорость. Идёт к лаборатории. Турель стреляет и стреляет. Не хитрый. Не умный. Просто не останавливается. Пока не уничтожен — отвлекает огонь. За ним идут мелкие. Много урона.", lesson = nil },
	["Заживалка"] = { text = "Средний размер. Среднее здоровье. Очень высокая регенерация. Получил урон — восстановился почти сразу. Не толстый. Не быстрой. Просто не удаётся уничтожить пока стреляешь. Нужен тяжёлый снаряд или комбо чтобы уничтожить за один раз.", lesson = nil },
	["Кислотник"] = { text = "Не разрушает. Плюёт кислоту на стену. Стена размягчается. Работяги разрушают размягченную стену в разы быстрее. Один кислотник бесполезен. Кислотник + работяги = стена разрушается быстро.", lesson = nil },
	["Координатор"] = { text = "Не трогает стены. Указывает солдатам какую турель атаковать. Без координатора солдаты идут каждый на ближайшую. С координатором — все на одну. Уничтожить координатора — солдаты теряют фокус.", lesson = nil },
	["Кукольник"] = { text = "Заворачивает раненого жука в кокон. Через время из кокона выходит жук следующей касты. Разведчик — работяга. Работяга — солдат. Нельзя оставлять раненых.", lesson = nil },
	["Лицехват"] = { text = "Летающий. Не атакует. Присасывается к турели — турель полностью перестаёт стрелять. Снимается только уроном других турелей. Уничтожен — турель немедленно возвращается к работе. Мало здоровья, высокая скорость. После того как присосался к турели, получает минимальный урон сам по себе.", lesson = nil },
	["Матка"] = { text = "Прилетает на карту, откладывает личинку и уходит. Личинка стоит на месте. Через время вылупляется большая группа мелких жуков. Нужно уничтожить личинку до вылупления.", lesson = nil },
	["Медик"] = { text = "Не атакует. Лечит других жуков. Переносит личинок и раненых. Выбирает зоны для лечения. Убить медика приоритетнее, но он за спинами работяг.", lesson = nil },
	["Мимик"] = { text = "Маскируется под мешок, обломок или даже турель. Стоит неподвижно. Турели не распознают как цель. В какой-то момент раскрывается и атакует.", lesson = nil },
	["Мини-жук"] = { text = "Маленький размер. Быстрый. Уничтожается от одного попадания. Их очень много. Блуждают как стандартные. Пугаются как стандартные. Но одной турели не хватает — она не успевает перезаряжаться. Даже стены грызть не может.", lesson = "одной турели не хватает. Нужно больше покрытия." },
	["Моль"] = { text = "Летит к светящимся элементам. Не разрушает. Не наносит урона. Просто летает и мешает.", lesson = "не только пол. Юниты умеют летать." },
	["Носитель"] = { text = "Несёт внутри других жуков. Уничтожен — жуки высыпаются. Если добрался до лаборатории — выпускает внутри обороны.", lesson = nil },
	["Пеликан"] = { text = "Ест трупы жуков. Труп исчезает. Умеет летать, а когда съест трупы — становится наземным. Перемещается между трупами по воздуху. Когда наестся — оставляет строительный материал для жуков. И идёт в бой.", lesson = nil },
	["Подрывник"] = { text = "Несёт взрывной заряд. Подходит к стене, активирует. Стена получает множество урона. Сам уничтожается вместе с зарядом. Попадание в заряд — преждевременная детонация.", lesson = nil },
	["Работяга"] = { text = "Базовый работяга. Разрушает стены и стол. Получает урон — отходит в безопасное место. Ждёт пока рядом соберётся 5 работяг. Группой выходят. Встретили турель — группой атакуют. Могут таскать строй-материалы. Сам по себе — не опаснее разведчика. Группой — проблема.", lesson = nil },
	["Разносчик"] = { text = "Впитывает элементы которыми в него стреляют. Накапливает. Взрывается впитанными элементами. Может впитать несколько элементов.", lesson = nil },
	["Спринтер"] = { text = "Маленький. Очень быстрый. Мало здоровья. Летит к лаборатории мимо всего. Если не уничтожить в пути — добежит.", lesson = nil },
	["Стандарт"] = { text = "Базовый разведчик. Средний размер. Блуждает по полу. Находит стол — грызёт. Получает урон — пугается, отходит, возвращается через 3 секунды. Их много. Легко уничтожить. Каждый отдельно — не проблема. Но они постоянно возвращаются. Может грызть стены, но не будет. Толку мало.", lesson = "турель работает. Стрелять — жук уничтожен. Но одного выстрела мало." },
	["Строитель"] = { text = "Толстый. Ест обломки стены или мебели. Из собранного строит на карте. Строит три типа конструкций и выполняет одну земляную работу, все из обломков, все уничтожаются тяжёлым снарядом и горят: Стена — вертикальная преграда. Блокирует линию огня турелей. Жуки за ней группируются безопасно. Пандус — наклонная поверхность, прислонённая к стене игрока. По пандусу жуки забегают на стену и спрыгивают за ней. Мелкие проходят быстро, крупные теряют скорость. Кормушка — куча еды из обломков. Жуки рядом с кормушкой регенерируют здоровье. Не медик лечит — жук ест и сам восстанавливается. Кормушка со временем истощается. Ямка — строитель выкапывает небольшое углубление вокруг своих построек. Жуки в ямке ниже линии огня турелей. Радиус поражения резко падает.", lesson = nil },
	["Таран"] = { text = "Тяжёлый. Долго нацеливается. Разгоняется по прямой. Проламывает препятствия. На разгоне не поворачивает. После столкновения оглушается. Смещённые стены и повороты — контр.", lesson = nil },
	["Тень"] = { text = "Маленький размер. Турели реагируют с задержкой. Не иммунитет. Не маскировка. Просто реакция турели замедлена. Пока турель определила цель — он уже прошёл.", lesson = nil },
	["Хмурый брон"] = { text = "Слепой. Не видит турели. Не пугается. Не паникует. Имеет броню, и более медленную скорость. Идёт вдоль стен. Разрушает всё что попадается. Стена — разрушает. Труба — разрушает. Лабораторный стол — разрушает. Не потому что целится в стол. Потому что стол на пути. Мебель не ищет: не мешает — не грызёт. Не возвращается в гнездо. Не докладывает данные. Идёт по периметру и разрушает. Пока не уничтожен.", lesson = "периметр тоже нужен. Броня существует. Против неё — тяжёлые снаряды и определённые элементы." },
	["Щитоносец"] = { text = "Несёт широкий лобовой щит. Закрывает не только себя, но и идущих сзади. Турель стреляет в щит — эффект минимальный. За ним идут работяги без огня. Перекрёстный огонь обходит щит.", lesson = nil },
