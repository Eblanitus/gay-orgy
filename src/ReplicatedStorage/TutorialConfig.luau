-- Обучение на уровне 1 (задача #298): что открыто и какие шаги проходит игрок.
-- Логика — в ServerScriptService.Tutorial, здесь только данные. Уровень включает обучение
-- полем tutorial = true в Levels; промокод test снимает все ограничения (см. PromoCode).
local TutorialConfig = {}

-- Что можно на обучении. Элементы — четыре базовых: только они и продаются (cost в Elements),
-- крафт, рулетка и апгрейдер закрыты целиком. Постройки — только Колба.
TutorialConfig.elements = { Fire = true, Water = true, Earth = true, Air = true }
TutorialConfig.towers = { Ballista = true }

-- Стартовая Колба на обучении стоит пустой, а этот элемент лежит в сумке — первый шаг
-- как раз залить его в турель.
TutorialConfig.starterElement = "Fire"

-- Шаги по порядку. action — действие игрока, need — сколько раз оно должно случиться
-- за забег (считается всё, что уже сделано, в любом порядке). Текущий шаг — первый
-- невыполненный; шаг "wave" выполняется стартом волны и до него волну не запустить.
TutorialConfig.steps = {
	{ action = "pour", need = 1, text = "Подойди к Колбе в центре и залей в неё Огонь (E у турели)" },
	{ action = "build", need = 1, text = "Поставь вторую Колбу: B — режим стройки, зажми клетку" },
	{ action = "buy", need = 1, text = "Подойди к производителю элементов и купи любой элемент" },
	{ action = "pour", need = 2, text = "Залей купленный элемент в новую Колбу" },
	{ action = "wave", need = 1, text = "Всё готово — запускай волну" },
}

return TutorialConfig
