-- Обучение на уровне 1 (задачи #298, #432): что открыто и какие шаги проходит игрок.
-- Логика — в ServerScriptService.Tutorial, здесь только данные. Уровень включает обучение
-- полем tutorial = true в Levels; промокод test снимает ограничения (см. PromoCode).
local TutorialConfig = {}

-- Что можно на обучении. Элементы — четыре базовых: только они и продаются (cost в Elements),
-- крафт, рулетка и апгрейдер закрыты целиком. Постройки — только Колба.
TutorialConfig.elements = { Fire = true, Water = true, Earth = true, Air = true }
TutorialConfig.towers = { Ballista = true }

-- Материя на старте обучения: ровно один базовый элемент для стартовой Колбы. Сумка пуста —
-- элемент игрок покупает сам, это и есть первый шаг.
TutorialConfig.startMatter = 10

-- Где стоит стартовая Колба: сдвиг от центра лабораторного стола (studs, X и Z). Из центра
-- арены Колба (радиус 30) не доставала до жуков, грызущих стол; отсюда до любой точки
-- вокруг стола 12–24 studs, а до прохода жуков от входа остаётся ~6 studs.
TutorialConfig.starterOffset = Vector3.new(-18.4, 0, 4)

-- Волны, на которых стол не ломается: здоровье не опускается ниже 1, волна идёт до конца.
TutorialConfig.guardedWaves = 2

-- После какой волны обучение засчитано (уровень пройден, следующий открыт). Проигрыш
-- следующей волны этого уже не отменяет.
TutorialConfig.completeAfterWave = 2

-- Шаги по порядку. action — действие игрока, need — сколько раз оно должно случиться
-- за забег (считается всё, что уже сделано, в любом порядке). Текущий шаг — первый
-- невыполненный. Волну нельзя запустить, пока текущий шаг не "wave": пока шаги до него
-- не пройдены, кнопки волны нет вовсе. Пока текущий шаг "build", магазин закрыт
-- (Tutorial.ElementAllowed): иначе игрок мог спустить на элементы деньги, отложенные
-- на Колбу, и застрять без кнопки волны. После постройки ограничений нет.
-- text — для ПК, mobile — для телефона (там нет клавиш E и B). Нет mobile — общий text.
TutorialConfig.steps = {
	{ action = "buy", need = 1,
		text = "Подойди к производителю элементов и купи любой элемент" },
	{ action = "pour", need = 1,
		text = "Подойди к Колбе у стола и залей в неё элемент — клавиша E у турели",
		mobile = "Подойди к Колбе у стола и нажми «Залить элемент»" },
	{ action = "wave", need = 1,
		text = "Готово! Зажми кнопку волны и смотри, как Колба отбивает жуков" },
	{ action = "build", need = 1,
		text = "Поставь свою Колбу: B — режим стройки, наведи на клетку и зажми мышь",
		mobile = "Поставь свою Колбу: кнопка «Стройка», затем зажми клетку пальцем" },
	{ action = "wave", need = 2,
		text = "Новой Колбе нужен элемент: купи и залей его. Потом запускай волну" },
	{ action = "wave", need = 3,
		text = "Последняя волна сильнее и с бронёй. Ставь ещё Колбы, если считаешь нужным" },
}

return TutorialConfig
