-- Обучение на уровне 1 (задача #298): что открыто и какие шаги проходит игрок.
-- Логика — в ServerScriptService.Tutorial, здесь только данные. Уровень включает обучение
-- полем tutorial = true в Levels; промокод test снимает все ограничения (см. PromoCode).
local TutorialConfig = {}

-- Что можно на обучении. Элементы — четыре базовых: только они и продаются (cost в Elements),
-- крафт, рулетка и апгрейдер закрыты целиком. Постройки — только Колба.
TutorialConfig.elements = { Fire = true, Water = true, Earth = true, Air = true }
TutorialConfig.towers = { Ballista = true }

-- Стартовая Колба на обучении стоит пустой, а этот элемент лежит в сумке — первый шаг
-- как раз залить его в турель.
TutorialConfig.starterElement = "Fire"

-- Шаги по порядку. action — действие игрока, need — сколько раз оно должно случиться
-- за забег (считается всё, что уже сделано, в любом порядке). Текущий шаг — первый
-- невыполненный. Волну нельзя запустить, пока текущий шаг не "wave": пока шаги до него
-- не пройдены, кнопки волны нет вовсе. Последний шаг — совет на первую волну: он висит,
-- пока идёт волна 1, и гаснет стартом волны 2.
-- text — для ПК, mobile — для телефона (там нет клавиш E и B). Нет mobile — общий text.
TutorialConfig.steps = {
	{ action = "pour", need = 1,
		text = "Подойди к Колбе в центре арены и залей в неё Огонь — клавиша E у турели",
		mobile = "Подойди к Колбе в центре арены и нажми «Залить элемент» — залей Огонь" },
	{ action = "build", need = 1,
		text = "Поставь вторую Колбу: B — режим стройки, наведи на клетку и зажми мышь",
		mobile = "Поставь вторую Колбу: кнопка «Стройка», затем зажми клетку пальцем" },
	{ action = "buy", need = 1,
		text = "Новой Колбе нужен элемент. Подойди к производителю элементов и купи любой" },
	{ action = "pour", need = 2,
		text = "Залей купленный элемент в новую Колбу" },
	{ action = "wave", need = 1,
		text = "Готово! Зажми кнопку волны и отбей жуков" },
	{ action = "wave", need = 2,
		text = "Жуки идут к лабораторному столу. Между волнами ставь ещё Колбы и заливай в них элементы" },
}

return TutorialConfig
