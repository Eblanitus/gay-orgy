-- Экономика забега: материя только из трупов (по вики). Здесь только числа; логика —
-- ServerScriptService.Corpses (запись трупа и его ценность), Carriers (носильщики),
-- Bioreactor (переработка), Matter (кошелёк).
--
-- Убийство само материи не даёт. Ценность целого трупа — Enemies[вид].matter (бывшая награда
-- за убийство), дальше её режет целостность: вид останков решает добивающий удар
-- (Effects.RemainsOf), и чем сильнее элемент разрушает тело, тем меньше выйдет материи.
local Economy = {}

-- Доля ценности целого трупа по виду останков (Effects.RemainsOf). Нет вида в таблице — 0:
-- увозить нечего, записи трупа не заводится.
Economy.integrity = {
	body = 1.0, -- целый: Вода, Воздух, пустая турель; Огонь, потушенный Водой, — тоже сюда
	brittle = 0.8, -- промёрзший: тело есть, пока не лопнул от касания (лопнул — запись снята)
	crush = 0.4, -- лепёшка: биомасса на месте, но мятая
	char = 0.4, -- обугленный: горел в момент смерти; осыпался — запись снята
	gib = 0.3, -- клочья (Порох, Взрыв): остались только лапы
	ash = 0.15, -- угли: обугленный осыпался, пока его не увезли (Пеликан такое уже не ест)
	melt = 0.2, -- лужица: носильщик-«пылесос» собирает немного
	-- dissolve, destroy, transform (метка смерти), статуя Глины — тела нет: 0
}

-- Множитель ценности целого трупа к Enemies[вид].matter. Ручка калибровки симулятором:
-- одна на все виды, чтобы не переписывать таблицу жуков.
Economy.valueScale = 1

-- Сколько носильщиков нужно на тушу: (масштаб жука / 3)² — Стандарт 1, Таран 2, Гигант 4.
-- Останки без тела (лепёшка, клочья, лужица) лёгкие — им всегда один.
Economy.crewArea = 3
Economy.crewMax = 4
Economy.lightRemains = { crush = true, gib = true, melt = true }

-- Сколько секунд Биореактор перерабатывает один груз, прежде чем выдать материю.
Economy.processTime = 1.5

-- Сбор без носильщиков: записи трупов сами уходят в переработку через столько секунд после
-- смерти. nil — выключен: трупы возят носильщики (Carriers). Остался для проверок.
Economy.autoCollectDelay = nil

-- Носильщики (Carriers): скорость пустого и с грузом, studs/с; сколько секунд бригада
-- берёт тушу; как часто раздаются задания; высота центра дрона над полом.
Economy.carrierSpeed = 14
Economy.carrierLoadedSpeed = 10
Economy.pickupTime = 0.6
Economy.assignInterval = 0.5
Economy.carrierLift = 0.35

-- Радиус, в котором клиент убирает лежащие останки без своей туши (лепёшка, клочья, лужица),
-- когда их подобрали, studs при масштабе 3.
Economy.scrapRadius = 2.5

return Economy
