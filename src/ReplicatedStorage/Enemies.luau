-- Виды по кастам — собирается из самой таблицы, а не выписывается вторым списком:
-- второй список разошёлся бы с таблицей на первом же новом жуке. Нужен Кукольнику:
-- из кокона выходит жук СЛЕДУЮЩЕЙ касты, а какой именно — документ не уточняет.
--
-- Личинка и Матка в списки не попадают: первая не ходит вовсе, вторая улетает с
-- карты — ни та, ни другая не годится тем, кто выходит из кокона в бой.
Enemies.ByCaste = {}
for key, data in Enemies do
	if data.caste and data.speed and data.speed > 0 and not data.lays then
		local list = Enemies.ByCaste[data.caste]
		if not list then
			list = {}
			Enemies.ByCaste[data.caste] = list
		end
		table.insert(list, key)
	end
end
for _, list in Enemies.ByCaste do
	-- Порядок обхода словаря в Luau не определён, а кукольник берёт из списка
	-- случайный элемент: без сортировки один и тот же сид давал бы разные ответы
	-- от запуска к запуску, и повторить баг по логам было бы невозможно.
	table.sort(list)
end

return Enemies
